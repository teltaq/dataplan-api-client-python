# Copy to .env and load it (see README), or export these in your shell.
TELTAQ_API_KEY=tq_sk_replace_me
# Local backend. Production: https://api.teltaq.com/v1
TELTAQ_BASE_URL=http://localhost:8000/v1
# Optional: the chat model (provider_connection_id) pre-selected in pickers
TELTAQ_MODEL=
# Optional: 1 = start with request/response logging on
TELTAQ_VERBOSE=0
